# CSM bot configuration. Copy to .env and fill in.
# Everything is validated at startup — a bad value stops the container with a clear message rather
# than producing a brief with a hole in it a week later.

# ── Required ──────────────────────────────────────────────────────────────────

# Create the bot with @BotFather in Telegram, then get the chat id by sending it a message and
# reading https://api.telegram.org/bot<TOKEN>/getUpdates — the id is result[].message.chat.id.
# Only this chat is answered; anyone else who finds the bot gets nothing back.
CSM_TELEGRAM_TOKEN=
CSM_TELEGRAM_CHAT_ID=

# ── Strongly recommended ──────────────────────────────────────────────────────

# Ethereum RPC endpoints, comma-separated, tried in order. Leave blank to use public fallbacks
# (publicnode, llamarpc, cloudflare).
#
# Put a private endpoint first once this is deployed. Public providers throttle datacenter IPs far
# harder than residential ones, and a throttled run means a permanent hole in the history — most of
# what this bot measures is only observable live and cannot be backfilled.
#
# Note: cloudflare-eth.com does not support JSON-RPC batching and is skipped for batched reads.
CSM_RPC_URLS=

# ── Schedule ──────────────────────────────────────────────────────────────────

# These are deployment defaults. /settings can override them from the authorised Telegram chat;
# runtime overrides are stored in the SQLite database and survive redeploys.

# Daily collection hour, UTC. One collection per UTC day, at this hour.
# Keep it before the brief hour so Monday's brief includes that morning's read.
CSM_COLLECT_HOUR_UTC=6

# Weekly brief: 0 = Monday. Hour is UTC.
CSM_BRIEF_WEEKDAY=0
CSM_BRIEF_HOUR_UTC=7

# ── Storage ───────────────────────────────────────────────────────────────────

# Both live on the persistent volume. Losing them loses history that cannot be rebuilt: daily
# validator counts, queue depth and claim status are only observable live.
CSM_DB_PATH=/data/csm.db
CSM_IPFS_CACHE_DIR=/data/ipfs

# ── Optional ──────────────────────────────────────────────────────────────────

# Assessment round cutoffs. Alerts fire 14 and 3 days before each.
# Format: label=YYYY-MM-DD, comma-separated. Leave blank for the built-in 2026 calendar
# (ICS Round 6 = 2026-09-07, IDVTC Round 2 = 2026-09-21, ICS Round 7 = 2026-12-07,
#  IDVTC Round 3 = 2026-12-21).
# This is also the value restored by /settings reset.
CSM_ROUNDS=

# A Pinata JWT. When set, every merkle tree the bot pulls from IPFS gets re-pinned, which keeps it
# retrievable for the operators who need it to generate a claim proof.
#
# The bot does not need this to work — it caches every tree locally regardless — so leaving it blank
# is fine. It is here because public gateways were measured dropping a two-month-old eligibility
# tree, and about 4MB a year is a cheap way to help.
CSM_PINATA_JWT=

# Collect and compute, print to stdout instead of sending to Telegram. Useful for a first run:
#   docker compose run --rm -e CSM_DRY_RUN=1 csm-bot python -m csmbot.main brief
CSM_DRY_RUN=
